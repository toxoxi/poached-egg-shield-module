// goforty migration for poached-eggs, macOS US layout.
// Rows: left 6 + right 6, repeated 3 times; bottom left 7 + right 7.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Match the author-published O51Go VIA config: TAPPING_TERM 180,
// HOLD_ON_OTHER_KEY_PRESS and QUICK_TAP_TERM 0.
&lt { tapping-term-ms = <180>; flavor = "hold-preferred"; quick-tap-ms = <0>; };
&mt { tapping-term-ms = <180>; flavor = "hold-preferred"; quick-tap-ms = <0>; };

/ {
    behaviors {
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LSFT | MOD_RSFT | MOD_LGUI | MOD_RGUI)>;
            keep-mods = <(MOD_LSFT | MOD_RSFT | MOD_LGUI | MOD_RGUI)>;
        };
    };
    macros {
        macro_left: macro_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&macro_tap &kp LC(LA(LEFT))>;
        };
        macro_right: macro_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&macro_tap &kp LC(LA(RIGHT))>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            display-name = "Base";
            bindings = <
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
                &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                &mo 3  &none  &kp LALT  &kp LGUI  &lt 1 LANG2  &kp SPACE  &none  &kp RET  &none  &lt 2 LANG1  &kp BSPC  &kp ESC  &none  &none
            >;
        };
        layer_1 {
            display-name = "Symbols";
            bindings = <
                &gresc  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp UNDER
                &kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp BSLH  &kp PIPE  &kp GRAVE  &kp TILDE  &kp COLON  &kp DQT
                &trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &kp LT  &kp GT  &kp QMARK  &none
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        layer_2 {
            display-name = "Navigation";
            bindings = <
                &kp ESC  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT  &none  &macro_left  &kp UP  &macro_right  &none  &none
                &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
                &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp KP_PLUS  &kp KP_MINUS  &kp KP_EQUAL  &kp LBKT  &kp RBKT  &none
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        layer_3 {
            display-name = "Shortcuts";
            bindings = <
                &kp LS(TAB)  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)  &none  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0  &trans
                &trans  &kp LG(N6)  &kp HOME  &kp PG_DN  &kp END  &none  &none  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp FSLH  &mt LGUI RET
                &trans  &kp LSHFT  &kp KP_N1  &kp F12  &kp LG(LS(N4))  &none  &none  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp DOT  &mt LSHFT ESC
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo 4  &kp LC(LS(LG(N4)))
            >;
        };
        layer_4 {
            display-name = "System";
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &none  &none  &none  &none  &none
                &studio_unlock  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &trans  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &trans  &none
            >;
        };
    };
};
